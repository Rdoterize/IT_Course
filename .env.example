# Copy this file to .env before using Docker Compose.
# Replace every blank password with a unique value.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
INITIAL_ADMIN_USERNAME=admin
# At least 8 characters, including letters and digits.
INITIAL_ADMIN_PASSWORD=
APP_PORT=8080
# Set true only when serving the application through HTTPS.
COOKIE_SECURE=false
